# PostgreSQL / PostGIS Connection String
# For local Docker: postgresql://postgres:postgres@localhost:5432/community_reports?schema=public
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_reports?schema=public"

# Optional Direct URL for migrations (if using PgBouncer / Supavisor connection pooler)
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Next.js Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

